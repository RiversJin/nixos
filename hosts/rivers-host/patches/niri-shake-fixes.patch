+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tracker() -> CursorScaleTracker {
+        let config = ShakeConfig { off: false, ..Default::default() };
+        CursorScaleTracker::new(Clock::default(), CursorScaleParams::from_config(config, &Animations::default()))
+    }
+
+    #[test]
+    fn straight_motion_does_not_expand_but_reversals_do() {
+        let mut t = tracker();
+        for x in [0.0, 120.0, 240.0, 360.0] {
+            t.on_motion((x, 0.0).into());
+        }
+        assert!(t.expand_anim.is_none());
+        t.on_motion((0.0, 0.0).into());
+        t.on_motion((360.0, 0.0).into());
+        assert!(t.expand_anim.is_some());
+    }
+
+    #[test]
+    fn enlarged_cursor_keeps_frames_until_decay_is_scheduled() {
+        let mut t = tracker();
+        t.current_mult = 3.0;
+        t.last_motion_instant = Some(Instant::now());
+        assert!(t.has_animations());
+        let mut cursor = CursorManager::new("default", 24);
+        t.last_motion_instant = Some(Instant::now() - Duration::from_secs(1));
+        t.advance_animations(&mut cursor);
+        assert!(t.pending_decay_at.is_some());
+        t.pending_decay_at = Some(Instant::now() - Duration::from_secs(1));
+        t.advance_animations(&mut cursor);
+        assert!(t.decay_anim.is_some());
+        t.clock.set_complete_instantly(true);
+        t.advance_animations(&mut cursor);
+        assert_eq!(t.current_mult, 1.0);
+        assert!(!t.has_animations());
+    }
+
+    #[test]
+    fn intensity_mode_returns_to_normal_when_motion_stops_after_shake() {
+        let mut t = tracker();
+        t.params.behavior = ShakeBehavior::IntensityBased;
+        t.current_mult = 3.0;
+        t.last_shake_factor = 5.0;
+        t.last_motion_instant = Some(Instant::now() - Duration::from_secs(1));
+        t.advance_animations(&mut CursorManager::new("default", 24));
+        assert!(t.pending_decay_at.is_some());
+    }
+
+    #[test]
+    fn disabling_feature_restores_normal_cursor() {
+        let mut t = tracker();
+        let mut cursor = CursorManager::new("default", 24);
+        t.current_mult = 3.0;
+        cursor.set_size_multiplier(3.0);
+        t.params.off = true;
+        assert!(t.advance_animations(&mut cursor));
+        assert_eq!(cursor.size_multiplier(), 1.0);
+        assert!(!t.has_animations());
+    }
+
+    #[test]
+    fn fractional_output_keeps_original_integer_buffer_size() {
+        let cursor = CursorManager::new("default", 24);
+        assert_eq!(cursor.effective_cursor_pixel_size(2, 1.5), 48);
+        assert_eq!(cursor.texture_pixel_size(2, 1.5), 48);
+        assert_eq!(cursor.texture_pixel_size(1, 1.0), 24);
+    }
+}
