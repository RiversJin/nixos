+#[cfg(test)]
+mod crop_tests {
+    use std::sync::Arc;
+
+    use smithay::utils::{Logical, Rectangle};
+
+    use super::{crop_to_subregion, BlurOptions, TransformedRegion};
+
+    fn region(rects: Vec<Rectangle<i32, Logical>>) -> TransformedRegion {
+        TransformedRegion { rects: Arc::new(rects), scale: 1.0.into(), offset: (0.0, 0.0).into() }
+    }
+
+    fn blur() -> Option<BlurOptions> {
+        Some(BlurOptions { passes: 3, offset: 4.0 })
+    }
+
+    #[test]
+    fn top_bar_keeps_halo_without_capturing_whole_4k_surface() {
+        let full = Rectangle::new((0.0, 0.0).into(), (2560.0, 1440.0).into());
+        let bar = region(vec![Rectangle::new((0, 0).into(), (2560, 32).into())]);
+        let crop = crop_to_subregion(full, &bar, blur(), 1.5);
+        assert_eq!(crop.loc, full.loc);
+        assert_eq!(crop.size.w, full.size.w);
+        assert_eq!(crop.size.h * 1.5, 160.0);
+        assert!(crop.size.h < full.size.h / 10.0);
+    }
+
+    #[test]
+    fn separated_regions_are_both_retained() {
+        let full = Rectangle::new((0.0, 0.0).into(), (1920.0, 1080.0).into());
+        let regions = region(vec![
+            Rectangle::new((0, 0).into(), (1920, 32).into()),
+            Rectangle::new((700, 500).into(), (300, 400).into()),
+        ]);
+        let crop = crop_to_subregion(full, &regions, blur(), 1.0);
+        assert_eq!(crop.size.h, 1008.0);
+        assert!(crop.contains_rect(Rectangle::new((700.0, 500.0).into(), (300.0, 400.0).into())));
+    }
+
+    #[test]
+    fn translated_scaled_regions_keep_pyramid_alignment() {
+        let full = Rectangle::new((100.0, 200.0).into(), (1280.0, 720.0).into());
+        let mut r = region(vec![Rectangle::new((200, 100).into(), (100, 100).into())]);
+        r.scale = 2.0.into();
+        r.offset = full.loc;
+        let crop = crop_to_subregion(full, &r, blur(), 1.5);
+        assert!(crop.contains_rect(Rectangle::new((500.0, 400.0).into(), (200.0, 200.0).into())));
+        assert_eq!(((crop.loc.x - full.loc.x) * 1.5) % 8.0, 0.0);
+        assert_eq!(((crop.loc.y - full.loc.y) * 1.5) % 8.0, 0.0);
+        assert_eq!((crop.size.w * 1.5) % 8.0, 0.0);
+        assert_eq!((crop.size.h * 1.5) % 8.0, 0.0);
+    }
+
+    #[test]
+    fn odd_size_and_fractional_pixel_origin_fall_back() {
+        let r = region(vec![Rectangle::new((0, 0).into(), (200, 30).into())]);
+        for full in [
+            Rectangle::new((0.0, 0.0).into(), (1919.0, 1080.0).into()),
+            Rectangle::new((0.5, 0.0).into(), (1920.0, 1080.0).into()),
+        ] {
+            assert_eq!(crop_to_subregion(full, &r, blur(), 1.0), full);
+        }
+    }
+
+    #[test]
+    fn empty_or_outside_region_falls_back() {
+        let full = Rectangle::new((0.0, 0.0).into(), (1920.0, 1080.0).into());
+        assert_eq!(crop_to_subregion(full, &region(vec![]), blur(), 1.0), full);
+        let r = region(vec![Rectangle::new((2000, 0).into(), (20, 20).into())]);
+        assert_eq!(crop_to_subregion(full, &r, blur(), 1.0), full);
+    }
+
+    #[test]
+    fn unblurred_effect_needs_no_sampling_halo() {
+        let full = Rectangle::new((0.0, 0.0).into(), (1920.0, 1080.0).into());
+        let r = region(vec![Rectangle::new((100, 200).into(), (300, 40).into())]);
+        assert_eq!(crop_to_subregion(full, &r, None, 1.0), Rectangle::new((100.0, 200.0).into(), (300.0, 40.0).into()));
+    }
+}
