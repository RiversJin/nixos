+#[cfg(test)]
+mod egl_crop_tests {
+    use std::sync::Arc;
+    use smithay::backend::allocator::Fourcc;
+    use smithay::backend::egl::{EGLContext, EGLDisplay, native::EGLSurfacelessDisplay};
+    use smithay::backend::renderer::element::Kind;
+    use smithay::backend::renderer::gles::GlesRenderer;
+    use smithay::utils::{Rectangle, Transform};
+    use crate::render_helpers::{render_to_vec, shaders, resources};
+    use crate::render_helpers::background_effect::RenderParams;
+    use crate::render_helpers::primary_gpu_texture::PrimaryGpuTextureRenderElement;
+    use crate::render_helpers::texture::{TextureBuffer, TextureRenderElement};
+    use super::{FramebufferEffect, FramebufferEffectElement, BlurOptions, TransformedRegion};
+
+    crate::niri_render_elements! { TestElement => {
+        Texture = PrimaryGpuTextureRenderElement,
+        Effect = FramebufferEffectElement,
+    } }
+
+    #[test]
+    fn egl_crop_matches_full_framebuffer() {
+        let mut renderer = unsafe {
+            let display = EGLDisplay::new(EGLSurfacelessDisplay).unwrap();
+            let context = EGLContext::new(&display).unwrap();
+            GlesRenderer::new(context).unwrap()
+        };
+        resources::init(&mut renderer);
+        shaders::init(&mut renderer);
+        let (w, h) = (1920usize, 1080usize);
+        let mut pixels = vec![0u8; w*h*4];
+        for y in 0..h {
+            for x in 0..w {
+                let i = (y*w+x)*4;
+                pixels[i] = if (x/7+y/11)%2 == 0 { 255 } else { 0 };
+                pixels[i+1] = ((x*19+y*3)%256) as u8;
+                pixels[i+2] = ((y*13+x*5)%256) as u8;
+                pixels[i+3] = 255;
+            }
+        }
+        let size = (w as i32,h as i32).into();
+        for scale in [1.0, 1.5] {
+            let background = TextureBuffer::from_memory(&mut renderer, &pixels, Fourcc::Abgr8888,
+                (w as i32,h as i32), false, scale, Transform::Normal, vec![]).unwrap();
+            let full = Rectangle::new((0.0,0.0).into(), (w as f64/scale,h as f64/scale).into());
+            for rects in [
+                vec![Rectangle::new((0,0).into(), (1200,32).into())],
+                vec![Rectangle::new((150,130).into(), (300,200).into())],
+                vec![Rectangle::new((0,0).into(), (1200,32).into()), Rectangle::new((700,300).into(), (180,180).into())],
+            ] {
+                let region = TransformedRegion { rects: Arc::new(rects), scale: 1.0.into(), offset: (0.0,0.0).into() };
+                let make_effect = || FramebufferEffect::new().render(None, RenderParams {
+                    geometry: full, subregion: Some(region.clone()), clip: None, scale,
+                }, Some(BlurOptions { passes: 3, offset: 4.0 }), 0.0, 1.0);
+                let render = |renderer: &mut GlesRenderer, effect: FramebufferEffectElement| {
+                    let texture = PrimaryGpuTextureRenderElement(TextureRenderElement::from_texture_buffer(
+                        background.clone(), (0.0,0.0), 1.0, None, None, Kind::Unspecified));
+                    render_to_vec(renderer, size, scale.into(), Transform::Normal, Fourcc::Abgr8888,
+                        vec![TestElement::Texture(texture), TestElement::Effect(effect)].into_iter()).unwrap()
+                };
+                let mut uncropped = make_effect();
+                uncropped.geometry = full;
+                let reference = render(&mut renderer, uncropped);
+                let optimized = render(&mut renderer, make_effect());
+                let max_diff = reference.iter().zip(&optimized).map(|(a,b)| a.abs_diff(*b)).max().unwrap();
+                let count = reference.iter().zip(&optimized).filter(|(a,b)| a.abs_diff(**b)>2).count();
+                eprintln!("scale={scale} rects={:?}: max_channel_diff={max_diff}, channels_over_2={count}", region.rects);
+                assert!(max_diff <= 2, "cropped blur differs from the full framebuffer");
+            }
+        }
+    }
+}
