+/// Bound framebuffer work before capture, not only when drawing the blurred result.
+///
+/// The blur pyramid samples outside the visible region. Keep a conservative halo and
+/// preserve the original pyramid's pixel phase. Odd-sized and fractionally positioned
+/// surfaces use the old path rather than subtly changing their filter kernel.
+fn crop_to_subregion(
+    geometry: Rectangle<f64, Logical>,
+    subregion: &TransformedRegion,
+    blur: Option<BlurOptions>,
+    scale: f64,
+) -> Rectangle<f64, Logical> {
+    if !scale.is_finite() || scale <= 0. {
+        return geometry;
+    }
+    let (grid, padding) = if let Some(blur) = blur {
+        let grid = 2f64.powi(i32::from(blur.passes.clamp(1, 31)));
+        // At each level: downsample offset + upsample 2*offset, plus bilinear support.
+        let padding = ((3. * blur.offset.abs() + 3.) * (grid - 1.)).ceil();
+        (grid, padding)
+    } else {
+        (1., 0.)
+    };
+    let origin = [geometry.loc.x * scale, geometry.loc.y * scale];
+    let size = [geometry.size.w * scale, geometry.size.h * scale];
+    if origin.iter().chain(size.iter()).any(|v| !v.is_finite() || (v - v.round()).abs() > 1e-6)
+        || size.iter().any(|v| *v <= 0. || v.round() % grid != 0.)
+        || !padding.is_finite()
+    {
+        return geometry;
+    }
+    let mut lo = [f64::INFINITY; 2];
+    let mut hi = [f64::NEG_INFINITY; 2];
+    for (a, b) in subregion.iter() {
+        if ![a.x, a.y, b.x, b.y].iter().all(|v| v.is_finite()) {
+            return geometry;
+        }
+        let a = [a.x * scale - origin[0], a.y * scale - origin[1]];
+        let b = [b.x * scale - origin[0], b.y * scale - origin[1]];
+        let a = [a[0].max(0.), a[1].max(0.)];
+        let b = [b[0].min(size[0]), b[1].min(size[1])];
+        if a[0] >= b[0] || a[1] >= b[1] {
+            continue;
+        }
+        for axis in 0..2 {
+            lo[axis] = lo[axis].min(a[axis]);
+            hi[axis] = hi[axis].max(b[axis]);
+        }
+    }
+    if !lo.iter().chain(hi.iter()).all(|v| v.is_finite()) {
+        return geometry;
+    }
+    for axis in 0..2 {
+        lo[axis] = (((lo[axis] - padding) / grid).floor() * grid).max(0.);
+        hi[axis] = (((hi[axis] + padding) / grid).ceil() * grid).min(size[axis]);
+    }
+    Rectangle::from_extremities(
+        ((origin[0] + lo[0]) / scale, (origin[1] + lo[1]) / scale),
+        ((origin[0] + hi[0]) / scale, (origin[1] + hi[1]) / scale),
+    )
+}
