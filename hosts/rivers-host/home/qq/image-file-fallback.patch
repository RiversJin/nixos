+fn image_file_png(uri: &[u8]) -> Option<Vec<u8>> {
+    use std::io::Read;
+    let uri = std::str::from_utf8(uri).ok()?.trim();
+    let path = Url::parse(uri).ok()?.to_file_path().ok()?;
+    let file = std::fs::File::open(path).ok()?;
+    let metadata = file.metadata().ok()?;
+    if !metadata.is_file() || metadata.len() > MAX_SELECTION_BYTES as u64 {
+        return None;
+    }
+    let mut data = Vec::new();
+    file.take(MAX_SELECTION_BYTES as u64 + 1)
+        .read_to_end(&mut data)
+        .ok()?;
+    if data.len() > MAX_SELECTION_BYTES {
+        return None;
+    }
+    normalize_png(data).ok().flatten()
+}
